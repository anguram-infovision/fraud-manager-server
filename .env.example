PORT=3001
API_BASE_PATH=/fraud/api

# Braintree credentials
BRAINTREE_GRAPHQL_URL=https://payments.sandbox.braintree-api.com/graphql
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=

# Braintree capability tier: basic | premium
BT_CAPABILITY_TIER=basic

# SQL Server — AppSolute AFS database (same server as disputes-manager)
SQL_SERVER=       # e.g. 192.168.100.226
SQL_DATABASE=     # e.g. XpanseArchwellAFSv2-Test
SQL_USER=
SQL_PASSWORD=

# SQLite database file path
DB_PATH=./data/fraud.db

# Optional TLS
# SSL_PFX_PATH=
# SSL_PFX_PASSPHRASE=
