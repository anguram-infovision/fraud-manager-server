<?xml version="1.0" encoding="utf-8"?>
<!--
  iisnode config for IIS-hosted deployment as the /fraud/api application (a
  nested IIS Application under the /fraud site). Physical path IS this
  dist/ output — server.js sits right next to this file.
  See deploy/iis/README.md for one-time setup and deploy steps.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <clear />
        <rule name="NodeApi" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      nodeProcessCommandLine="C:\nvm4w\nodejs\node.exe"
      node_env="production"
      loggingEnabled="true"
      devErrorsEnabled="true" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
